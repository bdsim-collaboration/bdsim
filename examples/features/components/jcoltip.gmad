d1: drift, l=0.2*m;
col1: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=10.0*cm, horizontalWidth=60.0*cm, xsize=2.5*cm;
col2: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=5.0*cm, horizontalWidth=60.0*cm, xsize=2.5*cm, ysize=5.0*cm;
col3: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_Ta", tipThickness=10.0*cm, horizontalWidth=60.0*cm, xsize=2.5*cm, xsizeLeft=5.0*cm;
col4: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=20.0*cm, horizontalWidth=60.0*cm, xsize=2.5*cm, xsizeRight=5.0*cm;
col5: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=5.0*cm, horizontalWidth=60.0*cm, xsize=0*cm, xsizeLeft=2.0*cm;
col6: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_Ta", tipThickness=10.0*cm, horizontalWidth=60.0*cm, xsize=0*cm, xsizeRight=2.0*cm;
col7: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=20.0*cm, horizontalWidth=60.0*cm, xsize=0*cm;
col8: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=10.0*cm, horizontalWidth=60.0*cm, xsizeLeft=2*m, xsizeRight=1*cm;
col9: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_C", tipThickness=5.0*cm, horizontalWidth=60.0*cm, xsizeRight=2*m, xsizeLeft=1*cm;
col10: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=10.0*cm, horizontalWidth=60.0*cm, xsizeRight=2*m, xsizeLeft=1*cm, jawTiltLeft=0.05;
col11: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=20.0*cm, horizontalWidth=60.0*cm, xsizeRight=2*m, xsizeLeft=1*cm, jawTiltRight=0.05;
col12: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_C", tipThickness=5.0*cm, horizontalWidth=60.0*cm, xsizeRight=2*m, xsizeLeft=1*cm, jawTiltLeft=-0.05, jawTiltRight=-0.05;
col13: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=10.0*cm, horizontalWidth=60.0*cm, xsizeRight=2*cm, xsizeLeft=1*cm, jawTiltLeft=0.05, jawTiltRight=-0.05;

! converging jaws
col14: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=4*mm, horizontalWidth=60.0*cm, xsizeLeft=1*cm, xsizeRight=1*cm, jawTiltLeft=-0.05,  jawTiltRight=0.05;

! over the mid point parallel jaws
col15: jcoltip, l=0.2*m, material="G4_W", tipMaterial="G4_Cu", tipThickness=4*mm,  horizontalWidth=60.0*cm, xsizeLeft=-10*cm, xsizeRight=12*cm;
col16: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=4*mm, horizontalWidth=60.0*cm, xsizeLeft=12*cm,  xsizeRight=-10*cm;

! both jaws tilted to the left on downstream side and offset to the right over the mid point
col17: jcoltip, l=0.2*m, material="G4_W", tipMaterial="G4_Cu", tipThickness=4*mm,  horizontalWidth=60.0*cm, xsizeLeft=-11.9*cm, xsizeRight=12*cm,    jawTiltLeft=0.1, jawTiltRight=0.1;

! both jaws tilted to the left on downstream side and offset to the left over the mid point
col18: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=4*mm, horizontalWidth=60.0*cm, xsizeLeft=12*cm,    xsizeRight=-11.9*cm, jawTiltLeft=0.1, jawTiltRight=0.1;

! both jaws tilted to the right on downstream side and offset to the right over the mid point
col19: jcoltip, l=0.2*m, material="G4_W", tipMaterial="G4_Cu", tipThickness=4*mm,  horizontalWidth=60.0*cm, xsizeLeft=-11.9*cm, xsizeRight=12*cm,    jawTiltLeft=-0.1, jawTiltRight=-0.1;

! both jaws tilted to the right on downstream side and offset to the left over the mid point
col20: jcoltip, l=0.2*m, material="G4_Cu", tipMaterial="G4_W", tipThickness=4*mm, horizontalWidth=60.0*cm, xsizeLeft=12*cm,    xsizeRight=-11.9*cm, jawTiltLeft=-0.1, jawTiltRight=-0.1;

! tapered jaws (a wedge, G4Trd, instead of the flat box above): l is the
! length of the flat jaw face at the beam, and each jaw grows from there by
! 2*depth/tan(taper angle), out to its outer edge at horizontalWidth/2. The
! element is therefore longer than l: here 10 mm + 2*30 mm/tan(12 deg) = 292 mm.
! taper_angle_deg/rad cannot be combined with a jawTilt.
col21: jcoltip, l=10*mm, material="G4_Cu", tipMaterial="G4_W", tipThickness=5*mm, horizontalWidth=8.0*cm, xsize=1*cm, taper_angle_deg=12;

! same geometry, taper given in rad instead of deg
col22: jcoltip, l=10*mm, material="G4_Cu", tipMaterial="G4_Ta", tipThickness=5*mm, horizontalWidth=8.0*cm, xsize=1*cm, taper_angle_rad=0.20943951;

! asymmetric jaws, both tapered: both have the same 10 mm flat face, the
! deeper (right) jaw sets the element length
col23: jcoltip, l=10*mm, material="G4_Cu", tipMaterial="G4_W", tipThickness=5*mm, horizontalWidth=8.0*cm, xsizeLeft=1.5*cm, xsizeRight=0.8*cm, taper_angle_deg=12;

! one-sided tapered jaw (xsizeLeft beyond the half width disables the left jaw,
! as in col8/col9 above)
col24: jcoltip, l=10*mm, material="G4_Cu", tipMaterial="G4_W", tipThickness=5*mm, horizontalWidth=8.0*cm, xsizeLeft=2*m, xsizeRight=1*cm, taper_angle_deg=20;

l1: line=(d1, col1, d1, col2, d1, col3, d1, col4, d1, col5, d1, col6, d1, col7, d1, col8, d1, col9, d1, col10, d1, col11, d1, col12, d1, col13);
l2: line=(d1, col14, d1, col15, d1, col16, d1, col17, d1, col18, d1, col19, d1, col20);
l3: line=(d1, col21, d1, col22, d1, col23, d1, col24);
ltotal: line=(l1, l2, l3);
use, ltotal;

beam, particle="e+",
      energy=100*GeV,
      distrType="gauss",
      sigmaX = 2*cm,
      sigmaY = 2*cm;


option, checkOverlaps=1,
        storeCollimatorInfo=1,
        storeCollimatorHitsAll=1,
        storeCollimatorHitsLinks=1;

option, physicsList="g4FTFP_BERT",
        minimumKineticEnergy=1*GeV;