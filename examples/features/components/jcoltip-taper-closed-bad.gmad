d1: drift, l=0.2*m;
! closed collimator (xsize, xsizeLeft and xsizeRight all zero) with a taper - the
! closed collimator is a plain block, so a taper is not supported and should fail
col1: jcoltip, l=10*mm, material="G4_Cu", tipMaterial="G4_W", tipThickness=5*mm, horizontalWidth=8.0*cm, xsize=0, taper_angle_deg=12;

lat: line=(d1, col1, d1);
use, lat;

beam, particle="e+",
      energy=7*GeV;

option, checkOverlaps=1,
        ngenerate=1;
