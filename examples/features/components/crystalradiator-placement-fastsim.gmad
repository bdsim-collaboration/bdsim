! A crystalradiator may be used as a regular beam-line element or as the
! geometry source of a placement.  The placed copy shares the FastSim region
! and model belonging to this crystal definition.

si111Placed: crystal, model="fastsim",
                     material="G4_Si",
                     lattice="(111)",
                     shape="box",
                     lengthX=2*mm,
                     lengthY=2*mm,
                     lengthZ=0.1*mm;

radiatorToPlace: crystalradiator, l=0.1*mm,
                 crystalDefinition="si111Placed";

radiatorPlacement: placement, bdsimElement="radiatorToPlace",
                   x=5*mm, z=10*cm;

reference: drift, l=1*mm;
line1: line=(reference);
use, line1;

beam, particle="e-", energy=855*MeV;
option, physicsList="completechannelling", ngenerate=1, checkOverlaps=1;
