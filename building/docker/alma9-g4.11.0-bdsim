FROM bdsim/alma9-g4.11.0

# Python support tools (pybdsim, pymadx, pymad8, pytransport, pyg4ometry)
RUN /bdsim/venv-bdsim/bin/pip install ipython &&\
    /bdsim/venv-bdsim/bin/pip install git+https://github.com/bdsim-collaboration/pytransport.git@develop &&\
    /bdsim/venv-bdsim/bin/pip install git+https://github.com/bdsim-collaboration/pymad8.git@develop &&\
    /bdsim/venv-bdsim/bin/pip install git+https://github.com/bdsim-collaboration/pymadx.git@develop &&\
    /bdsim/venv-bdsim/bin/pip install git+https://github.com/bdsim-collaboration/pybdsim.git@develop &&\
    /bdsim/venv-bdsim/bin/pip install uproot

# build BDSIM
RUN rm -rfv /usr/local/lib64/Geant4-11.0.4/Geant4PackageCache.cmake && \
    source /bdsim/setup.sh && \
    git clone https://github.com/bdsim-collaboration/bdsim.git &&\
    cd bdsim && git checkout develop && cd ../ &&\
    mkdir bdsim-build && cd bdsim-build &&\
    cmake ../bdsim -DUSE_PYTHON_BINDINGS=ON -DCMAKE_PREFIX_PATH="$(/bdsim/venv-bdsim/bin/python -m pybind11 --cmakedir)" -DUSE_PLASMA_HDF5=ON -DUSE_HEPMC3=ON && \
    make -j12 install &&\
    echo 'source /usr/local/bin/bdsim.sh' >> /bdsim/setup.sh &&\
    echo 'BDSIM install dir /usr/local' >> /bdsim/README
    