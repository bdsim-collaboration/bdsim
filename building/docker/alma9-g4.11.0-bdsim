FROM bdsim/alma9-g4.11.0

RUN yum install -y HepMC3-devel

# Python support tools (pybdsim, pymadx, pymad8, pytransport, pyg4ometry)
RUN python3 -m venv /tmp/venv-bdsim &&\
    /tmp/venv-bdsim/bin/pip install ipython &&\
    /tmp/venv-bdsim/bin/pip install git+https://github.com/bdsim-collaboration/pytransport.git@develop
    /tmp/venv-bdsim/bin/pip install git+https://github.com/bdsim-collaboration/pymad8.git@develop &&\
    /tmp/venv-bdsim/bin/pip install git+https://github.com/bdsim-collaboration/pymadx.git@develop &&\
    /tmp/venv-bdsim/bin/pip install git+https://github.com/bdsim-collaboration/pybdsim.git@develop

# build BDSIM
RUN source /tmp/root/bin/thisroot.sh && \
    git clone https://github.com/bdsim-collaboration/bdsim.git &&\
    cd bdsim && git checkout develop && cd ../ &&\
    mkdir bdsim-build && cd bdsim-build &&\
    rm -rfv /usr/local/lib/Geant4-10.7.4/Geant4PackageCache.cmake && \
    cmake ../bdsim -DUSE_HEPMC3=ON && make -j12 install &&\
    echo 'source /usr/local/bin/bdsim.sh' >> ~/.bashrc
    